# Python artifacts & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments & IDEs
.venv/
venv/
env/
ENV/
.idea/
.vscode/
.codex/
.agents/

# Testing & Type checking caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Git & environment secrets
.git/
.gitignore
.env

# Frontend artifacts (handled separately)
frontend/node_modules/
frontend/dist/

# Local media storage data (persisted via Docker volumes instead of baked into image)
data/uploads/*
data/outputs/*
data/proxies/*
!data/uploads/.gitkeep
!data/outputs/.gitkeep
!data/proxies/.gitkeep
