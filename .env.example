PROJECT_NAME="ClipForge AI"
API_V1_PREFIX="/api"
DEBUG=True

# Database (SQLite default for dev, Postgres for production)
DATABASE_URL="sqlite:///./clipforge.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# AI Services
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Storage & Processing Paths
UPLOAD_DIR="./data/uploads"
OUTPUT_DIR="./data/outputs"
MAX_UPLOAD_SIZE_MB=500

# Security & Access (Optional)
# API_KEY="your-secret-api-key"
# CORS_ORIGINS='["http://localhost:3000"]'

# Observability & Concurrency
LOG_LEVEL="INFO"
RENDER_CONCURRENCY_LIMIT=2
FFMPEG_TIMEOUT_SECONDS=600.0
AI_TIMEOUT_SECONDS=60.0
TIMELINE_SNAPSHOT_INTERVAL=10
